+/* --- keybinds in the Keyboard controls listing --------------------------
+ * The move / fire / shield rows show the player-configured keybinds,
+ * pushed from webglue.js via xgal_web_set_keymap() (order: left 0/1,
+ * right 0/1, fire 0/1, shield 0/1; 0 = unset).  Key codes are printable
+ * ASCII or 256..261 for the special keys (left, right, shift, ctrl, up,
+ * down).  Until the first sync (help_keys all zero) the original fixed
+ * listing is drawn. */
+#ifndef ORIGINAL_XGALAGA
+static int help_keys[8];
+static int help_redraw = 0;
+
+void xgal_web_set_keymap(k0, k1, k2, k3, k4, k5, k6, k7)
+int k0, k1, k2, k3, k4, k5, k6, k7;
+{
+    help_keys[0] = k0;
+    help_keys[1] = k1;
+    help_keys[2] = k2;
+    help_keys[3] = k3;
+    help_keys[4] = k4;
+    help_keys[5] = k5;
+    help_keys[6] = k6;
+    help_keys[7] = k7;
+    /* The keybind rows repaint onto the persistent framebuffer, so a
+     * shorter new listing would leave the tail of the old one behind
+     * until something else happened to redraw over it: force the row
+     * region to be cleared on the next draw (see show_help). */
+    help_redraw = 1;
+}
+
+static void help_key_label(k, buf)
+int k;
+char *buf;
+{
+    switch(k) {
+    case 256: strcpy(buf, "left"); break;
+    case 257: strcpy(buf, "right"); break;
+    case 258: strcpy(buf, "shift"); break;
+    case 259: strcpy(buf, "ctrl"); break;
+    case 260: strcpy(buf, "up"); break;
+    case 261: strcpy(buf, "down"); break;
+    case ' ': strcpy(buf, "space"); break;
+    default:
+        if(k >= 32 && k <= 126) {
+            buf[0] = (char)k;
+            buf[1] = 0;
+        } else
+            buf[0] = 0;
+        break;
+    }
+}
+
+/* "a / s" style listing of the (up to two) binds of action pair i. */
+static void help_action_keys(i, buf)
+int i;
+char *buf;
+{
+    help_key_label(help_keys[i*2], buf);
+    if(help_keys[i*2+1]) {
+        char t[16];
+        help_key_label(help_keys[i*2+1], t);
+        strcat(buf, " / ");
+        strcat(buf, t);
+    }
+}
+
+/* One table row of the Keyboard controls listing.  Every row - static
+ * or keybind - uses the same layout so center_text lines up the key
+ * column and the label column across the whole list: 2-space indent,
+ * a 29-char key field (the widest possible listing is
+ * "space / shift / space / shift") and a 16-char label field. */
+static void help_row(keys, label, y, color)
+char *keys;
+char *label;
+int y;
+W_Color color;
+{
+    char line[52];
+
+    snprintf(line, sizeof(line), "  %-29s%-16s", keys, label);
+    center_text(line, y, color);
+}
+
+/* One configurable row: kind 0 = move, 1 = fire, 2 = shield. */
+static void help_keybind_line(kind, y, color)
+int kind;
+int y;
+W_Color color;
+{
+    char k1[32], k2[32];
+
+    if(!help_keys[kind*2] && !help_keys[kind*2+1]) {
+        /* no keymap synced yet: the default web bindings */
+        help_row(kind == 0 ? "j / l" : kind == 1 ? "f" : "d",
+                 kind == 0 ? "move" : kind == 1 ? "fire" : "shield",
+                 y, color);
+        return;
+    }
+    if(kind == 0) {
+        char keys[48];
+
+        help_action_keys(0, k1);
+        help_action_keys(1, k2);
+        if(k1[0] && k2[0])
+            snprintf(keys, sizeof(keys), "%s / %s", k1, k2);
+        else
+            snprintf(keys, sizeof(keys), "%s", k1[0] ? k1 : k2);
+        help_row(keys, "move", y, color);
+        return;
+    }
+    help_action_keys(kind == 1 ? 2 : 3, k1);
+    help_row(k1[0] ? k1 : "-", kind == 1 ? "fire" : "shield", y, color);
+}
+#else
+#define help_keybind_line(kind, y, color) \
+    center_text((kind) ? "  space bar                    fire            " \
+                       : "  left/right arrow             move            ", (y), (color))
+#endif /* ORIGINAL_XGALAGA */
