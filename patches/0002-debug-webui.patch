+#ifndef ORIGINAL_XGALAGA
+/* --- web debug bridge ----------------------------------------------------
+ * Exported for the in-browser debug panel (debug_webui.js), shown when the
+ * page sets window.XGAL_DEBUG_WEBUI or the URL contains ?debug.  The panel
+ * and this code share the single emscripten thread (ASYNCIFY yields the
+ * game loop in the frame sleep), so plain global access is race-free; the
+ * setters may run at any time, paused or not.
+ *
+ * xgal_web_debug_state() slot map (int array, 18 slots):
+ *   0 level (1-based)    1 metaLevel        2 score
+ *   3 ships              4 maxtorps         5 numtorps (player torps in flight)
+ *   6 numetorps          7 maxetorps        8 movespeed*2
+ *   9 shield ticks (plshield+shieldsleft)   10 weapon
+ *   11 paused            12 gameOver        13 starspeed
+ *   14 livecount         15 gotlemon        16 startLevel
+ *   17 counter (sim tick counter: sim rate = delta / elapsed)
+ */
+void xgal_web_debug_state(out)
+int *out;
+{
+    out[0] = level;
+    out[1] = metaLevel;
+    out[2] = score;
+    out[3] = ships;
+    out[4] = maxtorps;
+    out[5] = numtorps;
+    out[6] = numetorps;
+    out[7] = maxetorps;
+    out[8] = (int)(movespeed * 2.0f);
+    out[9] = plshield + shieldsleft;
+    out[10] = weapon;
+    out[11] = paused;
+    out[12] = gameOver;
+    out[13] = starspeed;
+    out[14] = livecount;
+    out[15] = gotlemon;
+    out[16] = startLevel;
+    out[17] = counter;
+}
+
+void xgal_web_debug_set_start_level(n)
+int n;
+{
+    if(n < 1)
+	n = 1;
+    if(n > 9999)
+	n = 9999;
+    startLevel = n;
+}
+
+/* Start a new game immediately at level n (n <= 0: use startLevel). */
+void xgal_web_debug_start_game(n)
+int n;
+{
+    if(n >= 1)
+	xgal_web_debug_set_start_level(n);
+    start_new_game();
+}
+
+void xgal_web_debug_set_weapon(w)
+int w;
+{
+    int mn;
+
+    if(w < 0 || w >= NUMWEAPONS)
+	return;
+    if(w != weapon) {
+	weapon = w;
+	mn = weapon_mintorps(w, level);
+	if(maxtorps < mn)
+	    maxtorps = mn;
+    }
+}
+
+void xgal_web_debug_set_maxtorps(n)
+int n;
+{
+    if(n < 1)
+	n = 1;
+    if(n > MAXTORPS)
+	n = MAXTORPS;
+    maxtorps = n;
+}
+
+void xgal_web_debug_set_ships(n)
+int n;
+{
+    if(n < 0)
+	n = 0;
+    if(n > 10)
+	n = 10;
+    ships = n;
+}
+
+/* n = number of full shield icons to show (0..8). */
+void xgal_web_debug_set_shields(n)
+int n;
+{
+    if(n < 0)
+	n = 0;
+    if(n > 8)
+	n = 8;
+    shieldsleft = 0;
+    plshield = (n > 0) ? (n * SHIELDTIME - SHIELDTIME / 19) : 0;
+}
+
+/* n = number of speed prizes grabbed (0..4; clamped at MAXSPEED). */
+void xgal_web_debug_set_speed(n)
+int n;
+{
+    float v;
+
+    if(n < 0)
+	n = 0;
+    if(n > 4)
+	n = 4;
+    v = MINSPEED + (float)n;
+    if(v > MAXSPEED)
+	v = MAXSPEED;
+    movespeed = v;
+}
+
+void xgal_web_debug_set_paused(b)
+int b;
+{
+    paused = b ? 1 : 0;
+}
+#endif /* ORIGINAL_XGALAGA */
 int
