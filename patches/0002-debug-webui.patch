+
+/* n = number of speed prizes grabbed (0..5); matches the in-game
+ * half-step: each PR_SPEED prize does movespeed += 0.5 (prize.c). */
+void xgal_web_debug_set_speed(n)
+int n;
+{
+    if(n < 0)
+	n = 0;
+    if(n > 5)
+	n = 5;
+    movespeed = MINSPEED + 0.5f * (float)n;
+}
+
+void xgal_web_debug_set_paused(b)
+int b;
+{
+    paused = b ? 1 : 0;
+}
