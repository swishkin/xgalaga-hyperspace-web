+/* HUD icon renderer: xgal_icon slots map to Wlib palette entries. */
+static void draw_hud_icon(win, x, y, ic)
+W_Window win;
+int x, y;
+const struct xgal_icon *ic;
+{
+    static W_Color slotcolor[7];
+    static int inited = 0;
+    int i;
+
+    if(!inited) {
+	slotcolor[0] = W_Black;
+	slotcolor[1] = W_White;
+	slotcolor[2] = W_Grey;
+	slotcolor[3] = W_Yellow;
+	slotcolor[4] = W_Red;
+	slotcolor[5] = W_Cyan;
+	slotcolor[6] = W_Green;
+	inited = 1;
+    }
+    for(i = 0; i < ic->h * ic->w; i++) {
+	if(ic->idx[i] != XGAL_ICON_NONE)
+	    W_DrawPoint(win, x + i % ic->w, y + i / ic->w,
+			slotcolor[ic->idx[i]]);
+    }
+}
+
+#ifndef ORIGINAL_XGALAGA
+/* Equipment indicators on the score row: [weapon icon] [maxtorps]
+ * [speed icons], right-aligned on the same row as the Score:/Level: text
+ * and ship icons (shellWin, y 0..W_Textheight).  Fixed position - unlike
+ * the old strip left of the shield bar, the group does not shift as the
+ * shield count changes.  do_score() clears the whole row black whenever
+ * score/level/ships change, so this is drawn after do_score() each frame;
+ * the box clear below is black-on-black (the row's own background) and
+ * only exists to sweep stale pixels when the group content changes. */
+static void draw_equipment()
+{
+    /* Each speed prize steps movespeed by 0.5 (prize.c): MINSPEED 1.5 to
+     * MAXSPEED 4.0 is 6 levels, i.e. 0..5 prizes.  Every level is exactly
+     * representable in binary, so this count is exact. */
+    int nspeed = (int)((movespeed - MINSPEED) * 2.0f + 0.5f);
+    int maxnspeed = (int)((MAXSPEED - MINSPEED) * 2.0f + 0.5f);
+    int right = WINWIDTH - 2;
+    int x, total, tw, i;
+    char buf[8];
+
+    if(nspeed > maxnspeed)
+	nspeed = maxnspeed;
+    if(nspeed < 0)
+	nspeed = 0;
+
+    sprintf(buf, "%d", maxtorps);
+    tw = W_StringWidth(buf, W_RegularFont);
+    total = xgal_icon_weapon[weapon].w + 3 + tw + 3;
+    if(nspeed > 0)
+	/* trailing gap not drawn */
+	total += nspeed * (xgal_icon_speed.w + 1) - 1;
+    /* Fixed box (worst case: 11px icon + 3 + 2 digits + 3 + 5 speed
+     * icons = 57px): the group's left edge moves as its width changes,
+     * so a size-tracked clear would leave ghost pixels. */
+    W_ClearArea(shellWin, right - 60, 0, 60, W_Textheight);
+    x = right - total;
+    draw_hud_icon(shellWin, x, (W_Textheight - xgal_icon_weapon[weapon].h) / 2,
+		  &xgal_icon_weapon[weapon]);
+    x += xgal_icon_weapon[weapon].w + 3;
+    W_MaskText(shellWin, x, 0, W_White, buf, strlen(buf), W_RegularFont);
+    x += tw + 3;
+    for(i = 0; i < nspeed; i++)
+	draw_hud_icon(shellWin, x + i * (xgal_icon_speed.w + 1),
+		      (W_Textheight - xgal_icon_speed.h) / 2, &xgal_icon_speed);
+}
+#endif /* ORIGINAL_XGALAGA */
