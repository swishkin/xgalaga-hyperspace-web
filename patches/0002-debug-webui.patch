+/* Start a new game at startLevel (the title -> game transition).  Shared by
+ * the click start path and the web debug panel. */
+static void start_new_game()
+{
+    gameOver = 0;
+    plkeys = 0;   /* no stale key state: a movement key
+                   * released while the game-over screen was
+                   * up is swallowed there (no W_EV_KEY_OFF
+                   * handling), and 'plkeys' persists */
+    maxtorps = weapon_mintorps(SINGLESHOT, startLevel);
+    weapon = 0;
+    movespeed = MINSPEED;
+    ships = 2;
+#ifdef ACTIVATED_SHIELD
+    shieldsleft = STARTSHIELDS;
+    shieldon = 0;
+#else
+    shieldsleft = 0;
+#endif
+    level = startLevel;
+    init_aliens(level);
+    gotlemon = 0;
+    pldead = 0;
+    score = 0;
+    nextBonus = 20000;
+    plx = WINWIDTH/2;
+    W_ClearWindow(baseWin);
+}
