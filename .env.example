# XGalaga: Hyperspace — leaderboard.py knobs (docker compose loads this file
# via `env_file: .env`). Copy to .env and edit; .env is gitignored.
# All values below are the defaults unless noted.

# Server
XGAL_HOST=0.0.0.0
XGAL_PORT=8088
XGAL_WEBDIR=/app/www
XGAL_SCORES=/data/scores.json

# Board size (entries kept)
XGAL_MAX_HIGH_SCORES=100

# Security: when the game has a fixed public origin, lock the API to it so
# other websites cannot read/flood the board through a player's browser
# (see the security notes in README.md). Default * (any origin):
# XGAL_ORIGIN=https://xgal.example.com

# Reverse proxies whose X-Forwarded-For header may be trusted (the server
# takes the rightmost address in it, so a client cannot forge its own).
# Only loopback by default; in docker, add the proxy's network, e.g.
# XGAL_TRUSTED_PROXIES=127.0.0.1/32,::1/128,172.16.0.0/12
XGAL_TRUSTED_PROXIES=127.0.0.1/32,::1/128

# Abuse limits
XGAL_MAX_SCORE=1000000000
XGAL_MAX_LEVEL=9999
XGAL_MAX_BODY=4096
XGAL_RATE_LIMIT=5
XGAL_RATE_WINDOW=60

# Debug panel (dev only): the panel's code is always in the bundle; this
# switch decides whether it is SHOWN.  Anyone who can reach an enabled
# panel can use its powerup setters to farm scores on the shared board,
# so leave this off for a public deployment.
XGAL_DEBUG_PANEL=false
